{
  "version": 2,
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/server.ts"
    },
    {
      "src": "/chatbot",
      "dest": "/server.ts"
    },
    {
      "src": "/chatbot/",
      "dest": "/server.ts"
    }
  ]
} 